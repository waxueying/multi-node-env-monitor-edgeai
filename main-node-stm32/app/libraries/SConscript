Import('RTT_ROOT')
from building import *

cwd = GetCurrentDir()

src = Glob('STM32F4xx_HAL_Driver/Src/*.c')
src += Glob('CMSIS/Device/ST/STM32F4xx/Source/Templates/system_stm32f4xx.c')
if rtconfig.PLATFORM in ['armcc', 'armclang']:
    src += Glob('CMSIS/Device/ST/STM32F4xx/Source/Templates/arm/startup_stm32f407xx.s')
else:
    src += Glob('CMSIS/Device/ST/STM32F4xx/Source/Templates/gcc/startup_stm32f407xx.S')

CPPPATH = [cwd + '/STM32F4xx_HAL_Driver/Inc',
           cwd + '/STM32F4xx_HAL_Driver/Inc/Legacy',
           cwd + '/CMSIS/Device/ST/STM32F4xx/Include',
           cwd + '/CMSIS/Include',
           cwd + '/../drivers']

CPPDEFINES = ['STM32F407xx', 'USE_HAL_DRIVER']

group = DefineGroup('Libraries', src, depend = [''], CPPPATH = CPPPATH, CPPDEFINES = CPPDEFINES)

Return('group')
